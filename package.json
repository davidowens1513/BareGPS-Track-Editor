{
  "name": "baregps-track-editor",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "native:sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "format": "prettier --write src tests *.ts *.json index.html",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "build:web": "tsc --noEmit && vite build --base=/tools/baregps-route-planner/ --outDir web-dist"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "idb-keyval": "^6.2.2",
    "leaflet": "^1.9.4",
    "mgrs": "^2.2.0",
    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.21",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  }
}
